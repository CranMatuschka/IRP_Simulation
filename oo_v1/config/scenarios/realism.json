{
  "_comment": "Scenario direct cfg overlay for realism-grade runs. run_oo_v1 merges this onto config/masterConfig.m exactly like any other scenario JSON; no realismGradeConfig.m post-overlay is required.",
  "realism": {
    "grade": true,
    "directOverlay": true
  },
  "asset": {
    "clockType": "CESIUM1"
  },
  "clock": {
    "templateSource": "jowTable2p1"
  },
  "clockScaling": {
    "templateSource": "jowTable2p1"
  },
  "clocks": {
    "tower": {
      "product": {
        "sigmaBias_m": 0.10,
        "sigmaDrift_mps": 0.001
      }
    }
  },
  "measurements": {
    "codeNoise": {
      "model": "cn0",
      "cn0": {
        "enable": true,
        "base_dBHz": 45,
        "elevationGain_dB": 6,
        "sigmaAt45dBHz_m": 0.30
      }
    },
    "doppler": {
      "sigma_mps": 0.03
    },
    "carrier": {
      "sigma_m": 0.010
    },
    "isl": {
      "product": {
        "sigmaPos_m": 0.10,
        "sigmaClock_m": 0.10
      }
    }
  },
  "measurement": {
    "sigmaFloor_m": 0.01
  },
  "errors": {
    "multipath": {
      "enable": true,
      "truth": {
        "enable": true
      },
      "model": {
        "enable": true
      },
      "coloredGM": {
        "enable": true
      }
    },
    "hardwareDelay": {
      "enable": true,
      "truth": {
        "enable": true
      },
      "model": {
        "enable": true
      },
      "sigma_m": 0.5,
      "residualStochastic": {
        "enable": true
      }
    },
    "interAntennaCarrierBias": {
      "enable": true
    }
  },
  "effects": {
    "antennaPCV": {
      "enable": true,
      "truth": {
        "enable": true
      },
      "model": {
        "enable": true
      }
    },
    "towerSurvey": {
      "enable": true,
      "truth": {
        "enable": true
      },
      "model": {
        "enable": true
      }
    },
    "solidEarthTide": {
      "truth": {
        "enable": true
      }
    }
  },
  "biases": {
    "interFrequency": {
      "code": {
        "truth": {
          "L1_m": 0.30,
          "L2_m": 0.45
        }
      }
    }
  },
  "estimator": {
    "processNoise": {
      "modelMismatch": {
        "enable": true,
        "sigma_mps2": 1e-6
      }
    },
    "dynamics": {
      "perturbations": {
        "luniSolar": {
          "enable": true
        },
        "srp": {
          "enable": true,
          "Cr": 1.3,
          "areaToMass_m2pkg": 0.02
        },
        "epochJD_TT": 2451545.0
      }
    },
    "diffAtt": {
      "ambiguityResolution": {
        "enforcePhaseBiasStatus": true,
        "requirePhaseBiasCalibrationForFix": true
      }
    }
  },
  "orbit": {
    "truth": {
      "perturbations": {
        "luniSolar": {
          "enable": true
        },
        "srp": {
          "enable": true
        }
      }
    }
  },
  "physics": {
    "relativity": {
      "clock": {
        "enable": true,
        "truth": {
          "enable": true
        },
        "model": {
          "enable": true
        }
      }
    }
  },
  "frames": {
    "truthEop": {
      "enable": true,
      "polarMotion_xp_arcsec": 0.005,
      "polarMotion_yp_arcsec": 0.005,
      "ut1Rate_error_msPerDay": 0.05
    }
  },
  "carrierSlip": {
    "commonModeCompensation": {
      "enable": true,
      "minRows": 4
    },
    "baselineDifferencedMode": {
      "enable": true,
      "referenceAntenna": 1
    }
  }
}
