      "links": "all",
      "sigma_m": 0.02,
      "terminalLayout": "cones",
      "coneHalfAngle_deg": 70,
      "linksPerTerminal": 2,
      "delayCal": {
        "sigma_const_m": 0.05,
        "sigma_rw_m": 0.01,
        "tau_s": 3600,
        "nCorrCap": 60,
        "estimate": {
          "enable": true
        }
      },
      "lightTime": {
        "enable": true
      }
    },
