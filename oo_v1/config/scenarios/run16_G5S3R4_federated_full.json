{
  "_comment": "Federated full-stack scenario at G5S3R4, 3600 s. Same architecture and same ISL hardware assumptions as run15 (mode='fast' -> N independent EKFs + read-only relative layer; shape from the real four-timestamp two-way range, clock from the four-timestamp clock difference; ISL delayCal 0.05 m constant + 0.01 m drift, ISL-only). Only the constellation size changes, so the set is a clean scaling study. NOTE the relative layer's neighbour graph is capped at MAX_DEGREE=5 (SwarmRelativeSolver), so for N>6 each satellite links to its 5 nearest neighbours rather than to all others -- that is the intended link-budget-realistic topology, and it is the regime where the degree cap finally binds.",
  "scenario": {
    "name": "run16_G5S3R4_federated_full",
    "nTowers": 5,
    "nSpaceAssets": 3,
    "nReceivers": 4
  },
  "simulation": {
    "duration_s": 3600
  },
  "realism": {
    "grade": true
  },
  "atmosphere": {
    "realistic": true
  },
  "estimator": {
    "dynamics": {
      "perturbations": {
        "luniSolar": {
          "enable": true
        },
        "srp": {
          "enable": true
        }
      }
    }
  },
  "multiAsset": {
    "mode": "fast",
    "twoWayISL": {
      "enable": true,
      "links": "all",
      "sigma_m": 0.02,
      "delayCal": {
        "sigma_const_m": 0.05,
        "sigma_rw_m": 0.01,
        "tau_s": 3600,
        "nCorrCap": 60
      },
      "lightTime": {
        "enable": true
      }
    },
    "twoWayTimeTransferISL": {
      "sigma_m": 0.03,
      "delayCal": {
        "sigma_const_m": 0.01,
        "sigma_rw_m": 0.003,
        "tau_s": 3600,
        "nCorrCap": 60
      }
    },
    "federated": {
      "refAsset": 1,
      "savePerAssetMat": false,
      "parallel": false
    }
  },
  "measurements": {
    "twoWayTimeTransfer": {
      "enable": true,
      "useInEKF": true,
      "mode": "firstOrderReciprocal",
      "towers": "all",
      "sigma_m": 0.03,
      "includeReciprocityResidual": true,
      "reciprocitySigma_m": 0.005,
      "warmup_s": 0,
      "conservativeProductCorrelation": true
    },
    "isl": {
      "enable": true,
      "twoWay": {
        "enable": true,
        "timeTransfer": {
          "enable": true,
          "useInEKF": false,
          "mode": "firstOrderReciprocal",
          "sigma_m": 0.03,
          "warmup_s": 0
        },
        "range": {
          "enable": false,
          "useInEKF": false
        }
      }
    }
  },
  "report": {
    "layout": "clockExact",
    "runVersion": "run16-G5S3R4-federated-full",
    "writePdf": true,
    "writeMat": true
  }
}
