      "includeReciprocityResidual": true,
      "reciprocitySigma_m": 0.005,
      "warmup_s": 0,
      "conservativeProductCorrelation": true
    },
    "isl": {
      "enable": true,
      "twoWay": {
        "enable": true,
        "timeTransfer": {
          "enable": true,
          "useInEKF": false,
          "mode": "firstOrderReciprocal",
          "sigma_m": 0.03,
          "warmup_s": 0
        },
        "range": {
          "enable": false,
          "useInEKF": false
        }
      }
    }
  },
  "report": {
    "layout": "clockExact",
    "runVersion": "run17-G5S20R4-federated-multiring",
    "writePdf": true,
    "writeMat": true
  },
  "formation": {
