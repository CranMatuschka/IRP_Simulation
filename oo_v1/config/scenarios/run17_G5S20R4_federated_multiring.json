{
  "_comment": "G5S20R4 on a MULTI-RING helix. The single-ring layout put all 19 secondaries on one 1000 m ring, so the neighbour chord collapsed to 329 m (measured 328 m) and the shape solve diluted 27x to 4.11 m with weaklyObservable=1. mode='multiRingHelix' holds the SEPARATION at spacing_m and adds rings instead: ring 1 = 6 members at 1000 m radius, ring 2 = 13 members at 2000 m, along-ring chords 1000 m and 957 m. Everything else is identical to run16 so the comparison isolates the formation geometry.",
  "scenario": {
    "name": "run17_G5S20R4_federated_multiring",
    "nTowers": 5,
    "nSpaceAssets": 20,
    "nReceivers": 4
  },
  "simulation": {
    "duration_s": 3600
  },
  "realism": {
    "grade": true
  },
  "atmosphere": {
    "realistic": true
  },
  "estimator": {
    "dynamics": {
      "perturbations": {
        "luniSolar": {
          "enable": true
        },
        "srp": {
          "enable": true
        }
      }
    }
  },
  "multiAsset": {
    "mode": "fast",
    "twoWayISL": {
      "enable": true,
      "links": "all",
      "sigma_m": 0.02,
      "delayCal": {
        "sigma_const_m": 0.05,
        "sigma_rw_m": 0.01,
        "tau_s": 3600,
        "nCorrCap": 60
      },
      "lightTime": {
        "enable": true
      }
    },
    "twoWayTimeTransferISL": {
      "sigma_m": 0.03,
      "delayCal": {
        "sigma_const_m": 0.01,
        "sigma_rw_m": 0.003,
        "tau_s": 3600,
        "nCorrCap": 60
      }
    },
    "federated": {
      "refAsset": 1,
      "savePerAssetMat": false,
      "parallel": false
    }
  },
  "measurements": {
