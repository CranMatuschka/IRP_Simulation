{
  "scenario":    { "nSpaceAssets": 4, "nReceivers": 1 },
  "simulation":  { "duration_s": 3600 },
  "measurements": {
    "isl": {
      "enable": true,
      "transmitters": "all",
      "receiverAssetIndex": 1,
      "warmup_s": 300,
      "code":    { "enable": true, "useInEKF": true },
      "doppler": { "enable": true, "useInEKF": true },
      "carrier": {
        "enable": true,
        "useInEKF": true,
        "ambiguity": { "enable": true, "initialSigma_m": 100 },
        "slipDetection": { "enable": true }
      }
    }
  },
  "report": { "writePdf": true, "compileTex": "always", "writeMat": true },
  "plots":  { "enable": true, "showFigures": false }
}
